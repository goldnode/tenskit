.TH TENSPILE 1 "31 October 2026" "tenspile 0.1.0" "User Commands"
.SH NAME
tenspile \- inspect and edit tensor containers
.SH SYNOPSIS
.SY tenspile
.B \-c
.RB [ \-f ]
.I archive
.RI [ key=file
\&.\|.\|.]
.YS
.SY tenspile
.B \-t
.RB [ \-v ]
.RB [ \-\-columns ]
.RB [ \-\-fold ]
.RB [ \-\-sort ]
.RB [ \-f ]
.I archive
.RI [ key
\&.\|.\|.]
.YS
.SY tenspile
.B \-x
.RB [ \-f ]
.I archive
.RI [ key
\&.\|.\|.]
.YS
.SY tenspile
.B \-r
.RB [ \-f ]
.I archive
.I key=file
\&.\|.\|.
.YS
.SY tenspile
